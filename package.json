{
  "name": "rocketrota",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@noble/ciphers": "1.3.0"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:app": "vite dev --port 3000",
    "dev:admin": "npm run dev --workspace @rocketrota/admin",
    "build": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "start": "node .output/server/index.mjs",
    "build:admin": "npm run build --workspace @rocketrota/admin",
    "preview": "vite preview",
    "preview:admin": "npm run preview --workspace @rocketrota/admin",
    "test": "vitest run",
    "lint": "eslint src scripts vite.config.ts eslint.config.js",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "typecheck:admin": "npm run typecheck --workspace @rocketrota/admin",
    "auth:generate": ".\\node_modules\\.bin\\better-auth.cmd generate --config src\\lib\\auth.ts --output better-auth-schema.sql --yes",
    "auth:generate:review": ".\\node_modules\\.bin\\better-auth.cmd generate --config src\\lib\\auth.ts --output better-auth-schema.sql --yes",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "supabase:link:prod": "supabase link --project-ref your-project-ref",
    "supabase:push:prod": "supabase db push",
    "billing:reconcile": "node scripts/billing-reconcile.mjs",
    "billing:webhooks:status": "node scripts/billing-webhook-status.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@better-auth/passkey": "1.4.18",
    "@better-auth/stripe": "1.4.18",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/react": "^0.3.2",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/manrope": "^5.2.8",
    "@react-email/components": "^1.0.12",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/supabase-js": "^2.100.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-devtools": "^0.10.0",
    "@tanstack/react-form": "^1.28.5",
    "@tanstack/react-query": "^5.95.0",
    "@tanstack/react-router": "^1.167.4",
    "@tanstack/react-router-devtools": "^1.166.9",
    "@tanstack/react-router-ssr-query": "^1.166.9",
    "@tanstack/react-start": "^1.166.15",
    "@tanstack/router-plugin": "^1.166.13",
    "@types/mdx": "^2.0.14",
    "aes-cmac-js": "^1.0.2",
    "better-auth": "1.4.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-core": "^16.9.3",
    "fumadocs-mdx": "^15.0.11",
    "fumadocs-ui": "^16.9.3",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "nitro": "latest",
    "ntag424": "^0.3.9",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-resizable-panels": "^4.7.4",
    "recharts": "^2.15.4",
    "reflect-metadata": "0.2.2",
    "resend": "^6.12.3",
    "shadcn": "^4.1.0",
    "sonner": "^2.0.7",
    "stripe": "20.4.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.18",
    "@tanstack/devtools-vite": "^0.6.0",
    "@tanstack/eslint-config": "^0.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.15",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "supabase": "^2.84.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "web-vitals": "^5.1.0"
  }
}
